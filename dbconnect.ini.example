; ---------------------------------------------------------------
; Database connection configuration template
;
; Copy this file to:   ../secureconfig/dbconnect.ini
; (one level above the web root, outside of the html/ directory)
;
; The application expects it at that path so credentials are
; never served by the web server.
;
; --- Path note ---
; The path ../secureconfig/ is set in index.php:
;       $secureDir = "../secureconfig/";
; This assumes the web root is html/ and secureconfig/ sits beside it.
;
; On a real server (e.g. nginx, Apache on a VPS), adjust $secureDir
; in index.php to match wherever you place the config file on that
; server's filesystem — ideally somewhere outside the web root entirely,
; e.g. /etc/myapp/ or /var/private/myapp/.
;
; --- Database host note ---
; host = db        is the Docker Compose service name — correct for local dev.
; On a real server replace "db" with:
;   - "localhost"  if MySQL is on the same machine
;   - the IP/hostname of your remote database server otherwise
; ---------------------------------------------------------------

[database]
username = your_db_username
password = your_db_password
dbname = your_database_name
host = db
port = 3306
charset = utf8mb4
